---
alwaysApply: true
---
/**
 * Palette FPL — Bleu outremer et blanc
 * Couleurs principales : #10316F (navy) | #FFFFFF (blanc)
 * Source de vérité CSS : css/fpl-tokens.css
 */

:root {
  --navy: #10316F;
  --navy-deep: #0C2350;
  --blue: #2957AE;
  --blue-tint: #EDF1F8;
  --ground: #F4F6FA;
  --surface: #FFFFFF;
  --ink: #16203A;
  --slate: #5C6A85;
  --line: #DFE4EC;
  --orange: #FF6B35;

  --couleur-dominante: var(--navy);
  --couleur-dominante-hover: var(--navy-deep);
  --accent-promo: var(--orange);
  --fond-principal: var(--surface);
  --fond-secondaire: var(--ground);
  --titres: var(--ink);
  --texte-fonce: var(--ink);

  --font-titres: "Inter", "Segoe UI", system-ui, sans-serif;
  --font-corps: "Inter", "Segoe UI", system-ui, sans-serif;
}
