# Transmettre Authorization à PHP (Apache + PHP-FPM / reverse proxy Webuzo)
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# Autoriser uniquement api.php
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<Files "api.php">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</Files>
