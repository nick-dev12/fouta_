# Laisser passer les challenges SSL (Let's Encrypt / Webuzo)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

RewriteRule ^\.well-known/ - [L]

# www → domaine canonique HTTPS
RewriteCond %{HTTP_HOST} ^www\.e\.foutapoidslourds\.com$ [NC]
RewriteRule ^ https://e.foutapoidslourds.com%{REQUEST_URI} [L,R=301]

# HTTP → HTTPS (compatible Nginx reverse proxy Webuzo)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteRule ^ https://e.foutapoidslourds.com%{REQUEST_URI} [L,R=301]

RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# Directives PHP — mod_php uniquement (WAMP, Apache + mod_php)
# Avec PHP-FPM, utiliser le fichier .user.ini à la place
<IfModule mod_php.c>
php_value session.gc_maxlifetime 2592000
php_value upload_max_filesize 1000M
php_value post_max_size 1000M
php_value max_execution_time 300
php_value max_input_time 300
php_value memory_limit 512M
</IfModule>
