# Fichiers sensibles - NE JAMAIS committer
# Clés privées Firebase (service account)
sugar-paper-*.json
foouta-*.json
*-firebase-adminsdk-*.json
*firebase*credentials*.json

# Configuration Firebase mobile / web (clés API, identifiants projet)
GoogleService-Info.plist
google-services.json
**/google-services.json
**/GoogleService-Info.plist

# Archives et builds locaux
*.zip
appfouta.zip

# Configuration Flutter Firebase (clés VAPID / OAuth)
appfouta/lib/config/firebase_auth_config.dart

# Configuration base de données (identifiants)
conn/conn.php
conn/dconn.php

# Configuration API (clés secrètes)
config/emailjs.php
config/email.php
config/site.php
config/firebase_config.php
config/firebase_server.php
config/sync.php
config/import_production.php
config/deploy_wamp.php
config/pull_prod_dev.php
config/pull_prod_entreprise.php

# Variables d'environnement
.env
.env.*
!.env.example

# Uploads utilisateurs
upload/
uploads/

# Logs et cache
*.log
logs/
cache/
tmp/
temp/

# Profils client FTP (identifiants)
*.coreftp

# IDE et éditeurs
.idea/
.vscode/
*.swp
*.swo
*~

# Système d'exploitation
.DS_Store
Thumbs.db
desktop.ini

# Dossier local nommé « git » (hors dépôt)
git/

# Projets locaux de référence (copies / archives, hors dépôt)
poid_lourd/
fpl_natif-main/

# Polices d'étiquette : Windows / Monotype, non redistribuables — chaque poste
# dépose les siennes (voir fonts/LISEZ-MOI.md). Seul le mode d'emploi est versionné.
/fonts/*.ttf
# Cache de polices dompdf : régénéré par poste, et il embarque les polices ci-dessus.
/vendor/dompdf/dompdf/lib/fonts/fpl_*
/vendor/dompdf/dompdf/lib/fonts/installed-fonts.json
/vendor/dompdf/dompdf/lib/fonts/*.ufm.json
/vendor/dompdf/dompdf/lib/fonts/*.afm.json
# Configurations du serveur entreprise — secrets locaux, jamais dans Git
# (le guide des développeurs les marque « ne pas committer » ; les .example, eux, se committent)
config/update_entreprise.php
config/backup_local_to_vps.php
